#!/usr/bin/env bash
# Pre-push checks for the skills marketplace. Only what the push changes is checked.
#
#   0. scripts/                 skill spec, registry, manifest rules, counts, README, changed
#                               reference files, skills.sh discovery (see justfile)
#   1. claude plugin validate   marketplace + each changed plugin (errors block; warnings show)
#   2. skillevaluator Tier 1    each changed skill (static checks, no API key)
#   3. gitleaks                 secrets in the commits being pushed
#   4. lychee                   dead links in changed Markdown
#   5. zizmor + actionlint      only when .github/workflows/ changed
#
# Enable once per clone:  git config core.hooksPath scripts/hooks
# Skip once:              git push --no-verify   (or SKIP_PREPUSH=1 git push)
# A missing tool is reported and skipped, never a silent pass.

set -uo pipefail
[ "${SKIP_PREPUSH:-}" = "1" ] && { echo "pre-push: skipped (SKIP_PREPUSH=1)"; exit 0; }

export PYTHONUTF8=1 NO_COLOR=1 COLUMNS=200
ZERO=0000000000000000000000000000000000000000
EMPTY_TREE=$(git hash-object -t tree /dev/null)
failed=()

have() { command -v "$1" >/dev/null 2>&1 || { echo "  ! $1 not installed, check skipped"; return 1; }; }
step() { printf '\n== %s\n' "$1"; }

# Collect commits and files from every ref being pushed (stdin: local_ref local_sha remote_ref remote_sha).
ranges=(); files=""
while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue                      # branch deletion
  if [ "$remote_sha" = "$ZERO" ]; then
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null || echo "$EMPTY_TREE")
  else
    base=$remote_sha
  fi
  ranges+=("$base..$local_sha")
  files+=$(git diff --name-only --diff-filter=d "$base" "$local_sha")$'\n'
done
[ ${#ranges[@]} -eq 0 ] && exit 0
files=$(printf '%s' "$files" | tr -d '\r' | sort -u | sed '/^$/d')
[ -z "$files" ] && { echo "pre-push: no file changes"; exit 0; }

plugins=$(printf '%s\n' "$files" | sed -n 's|^skills/\([^/]*\)/.*|\1|p' | sort -u)
skill_dirs=$(printf '%s\n' "$files" | sed -n 's|^\(skills/[^/]*/skills/[^/]*\)/.*|\1|p' | sort -u)
# sed, not grep: some Windows grep builds add a carriage return to each output line.
# The README template's links are relative to the repo root, not scripts/; README.md itself is checked.
markdown=$(printf '%s\n' "$files" | sed -n '/^scripts\/readme_template\.md$/d; /\.md$/p')
workflows=$(printf '%s\n' "$files" | sed -n '/^\.github\/workflows\//p')

step "0. repo checks (scripts/)"
if have uv; then
  for s in check_skills check_registry lint_manifests check_counts; do
    uv run -q "scripts/$s.py" || failed+=("$s")
  done
  uv run -q scripts/build_readme.py --check || failed+=("README out of date")
  uv run -q scripts/sync_shared.py --check || failed+=("shared CLI rules out of sync")
  refs=$(printf '%s\n' "$markdown" | sed -n '/^skills\/[^/]*\/skills\/[^/]*\/references\//p')
  if [ -n "$refs" ]; then
    printf '%s\n' "$refs" | xargs -d '\n' uv run -q scripts/lint_references.py || failed+=("reference Contents")
  fi
  # sed, not grep, for the same carriage-return reason as above.
  if [ -n "$(printf '%s\n' "$files" | sed -n '/^skills\//p;/^\.claude-plugin\//p')" ] && have npx; then
    uv run -q scripts/check_discovery.py || failed+=("skills.sh discovery")
  fi
fi

step "1. claude plugin validate"
if have claude; then
  claude plugin validate . >/tmp/prepush-validate.txt 2>&1 || { cat /tmp/prepush-validate.txt; failed+=("marketplace manifest"); }
  for p in $plugins; do
    [ -f "skills/$p/.claude-plugin/plugin.json" ] || continue
    if claude plugin validate "skills/$p" >/tmp/prepush-validate.txt 2>&1; then
      echo "  ok $p"
    else
      cat /tmp/prepush-validate.txt; failed+=("plugin $p")
    fi
  done
fi

step "2. skillevaluator Tier 1 (changed skills)"
if [ -z "$skill_dirs" ]; then echo "  no skills changed"
elif have skillevaluator; then
  for d in $skill_dirs; do
    [ -f "$d/SKILL.md" ] || continue
    # Security is skipped: on Windows SkillEvaluator cannot run its bundled SkillSpector step.
    if skillevaluator validate "$d" --tiers 1 --skip security -r cli -o "${TMPDIR:-/tmp}/prepush-se" >/tmp/prepush-se.txt 2>&1; then
      echo "  ok ${d##*/}"
    else
      grep -E 'FAIL|\[(SCHEMA|QUALITY|PII|BANDIT|LINK)-HIGH\]|Dead link' /tmp/prepush-se.txt | sort -u | head -15
      failed+=("skill ${d##*/}")
    fi
  done
fi

step "3. gitleaks (pushed commits)"
if have gitleaks; then
  for r in "${ranges[@]}"; do
    case "$r" in "$EMPTY_TREE"*) r=${r#*..} ;; esac          # new branch with no merge-base: scan its history
    gitleaks git --no-banner --redact --log-opts="$r" . || failed+=("secrets in $r")
  done
fi

step "4. lychee (changed Markdown)"
if [ -z "$markdown" ]; then echo "  no Markdown changed"
elif have lychee; then
  # 403/429 are bot blocks and timeouts are often transient, so neither blocks. Results are cached for a week.
  printf '%s\n' "$markdown" | xargs -d '\n' lychee --no-progress --cache --max-cache-age 7d \
    --max-concurrency 16 --timeout 20 --accept-timeouts --accept '200..=299,403,429' || failed+=("dead links")
fi

step "5. zizmor + actionlint (workflows)"
if [ -z "$workflows" ]; then echo "  no workflows changed"
else
  have uvx && { uvx -q zizmor@1.32.0 .github/ || failed+=("zizmor"); }
  have actionlint && { actionlint || failed+=("actionlint"); }
fi

echo
if [ ${#failed[@]} -gt 0 ]; then
  printf 'pre-push: BLOCKED by %s\n' "$(IFS=', '; echo "${failed[*]}")"
  echo "Fix and push again, or skip once with: git push --no-verify"
  exit 1
fi
echo "pre-push: all checks passed"
