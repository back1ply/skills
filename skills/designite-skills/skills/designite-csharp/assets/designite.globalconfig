# Turns every analyzer off, then on only the rules that map to Designite smells.
# Needs -p:AnalysisMode=All on the build command line (otherwise these rules are never loaded).
is_global = true
global_level = 100
dotnet_analyzer_diagnostic.severity = none
# CA1051 visible instance fields      -> Deficient Encapsulation
dotnet_diagnostic.CA1051.severity = warning
# CA2211 non-constant visible statics -> Global State
dotnet_diagnostic.CA2211.severity = warning
# CA2214 overridable call in ctor     -> Abstract Function Call From Constructor
dotnet_diagnostic.CA2214.severity = warning
# CA1031 catches a general exception  -> review together with Empty Catch Clause
dotnet_diagnostic.CA1031.severity = warning
