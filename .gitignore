# Ignore everything by default
*

# Repo essentials
!.gitignore
!.gitattributes
!LICENSE
!README.md

# Plugin manifest
!.claude-plugin/
!.claude-plugin/**

# All plugins
!skills/
!skills/**
# Unpublished local plugins
skills/plugins/

# Source text behind generated skills (repo root only, not shipped with plugins)
!data/
!data/raw/
!data/raw/**
!data/articles/
!data/articles/**

# Design specs and docs
!docs/
!docs/**
__pycache__/
.ruff_cache/
# impatient-programming: full site mirror written by tools/refresh.sh (copyrighted, never commit)
skills/impatient-programming/_source/
# designite-skills test samples: build output and analysis results
skills/designite-skills/dev/samples/**/bin/
skills/designite-skills/dev/samples/**/obj/
skills/designite-skills/dev/samples/**/.designite/
*.sarif
.mypy_cache/
.venv/
