# Ignore everything by default
*

# Repo essentials
!.gitignore
!.gitattributes
!LICENSE
!README.md

# Plugin manifest
!.claude-plugin/
!.claude-plugin/**

# All skills (legacy root — being phased out)
!skills/
!skills/**

# All skills (monorepo structure)
!skills/
!skills/**
skills/plugins/

# Source text behind generated skills (repo root only, not shipped with plugins)
!data/
!data/raw/
!data/raw/**
!data/articles/
!data/articles/**

# Design specs and docs
!docs/
!docs/**
__pycache__/
